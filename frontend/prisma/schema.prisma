model KnowledgeVersion {

  id Int @id @default(autoincrement())

  // Relation
  assetId Int

  asset KnowledgeAsset
    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Version
  version Int

  // Snapshot
  title String
  slug String

  category String
  subcategory String?

  institution String?
  state String?
  year Int?

  author String?

  summary String?
  content String?

  source String?
  sourceUrl String?
  sourceReference String?

  tags String?

  status String

  publishedAt DateTime?
  publishedBy String?

  archivedAt DateTime?
  archivedBy String?

  filePath String?

  // Audit
  updatedBy String?

  changeNote String?

  createdAt DateTime @default(now())

  @@unique([assetId, version])

  @@index([assetId])

  @@index([assetId, version])

  @@index([createdAt])

}