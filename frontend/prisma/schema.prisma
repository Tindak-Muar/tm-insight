generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model KnowledgeAsset {
  id            Int      @id @default(autoincrement())

  title         String

  category      String
  subcategory   String?

  institution   String?
  state         String?

  year          Int?

  author        String?

  summary       String?
  content       String?

  tags          String?

  source        String?
  url           String?

  filePath      String?

  status        String   @default("Aktif")

  publishedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
